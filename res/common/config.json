        "scripting": true,
        "dynamicLibraries": false,
        "system": false,
        "prependLocation": true,
        "isolated": false,
        "enableFeatures": ["dictionaries", "words", "searchEngines", "judgers", "gamemodes", "problemsets", "validators", "languages"],
        "manifest": "manifest.json",
        "loadeds": [
            {"directory": "hardcore", "id": "com.minftis.hardcore"},
