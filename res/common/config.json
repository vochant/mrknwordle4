{
    "core": "aho-corasick",
    "base": {
        "answers": [
            {"file": "answer.dict", "type": "nbt"}
        ],
        "accepts": [
            {"file": "accept.dict", "type": "nbt"}
        ],
        "validation": true,
        "limit": -1,
        "virtualTerminal": true,
