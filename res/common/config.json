            {"id": "toutiao", "url": "https://so.toutiao.com/search?keyword=%s"},
            {"id": "perplexity", "url": "https://www.perplexity.ai/search?q=%s"},
            {"id": "phind", "url": "https://www.phind.com/search?q=%s"},
            {"id": "you", "url": "https://you.com/search?q=%s"},
            {"id": "chatgpt", "url": "https://chatgpt.com/?q=%s"},
