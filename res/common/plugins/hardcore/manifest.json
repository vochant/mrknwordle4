{
  "schemaVersion": 2,
  "id": "core.ext.hardcore",
  "name": "Hardcore Wordle",
  "version": "1.0.0",
  "author": "Mirekintoc",
  "license": "MIT",
  "description": "Changes one feedback tile for every guess.",
  "runtime": [{"id": "lua", "backend": "lua", "entry": "hardcore.lua", "exports": ["check", "compatible", "start", "finish"]}],
  "graders": {
    "core.ext.hardcore.grader": {
      "name": "Hardcore Wordle",
      "runtime": "lua",
      "exports": {"check": "check", "compatible": "compatible", "start": "start", "finish": "finish"},
      "deterministic": false,
      "states": {
        "0": {"color": "term:RGBL", "mode": "spoiler", "overrides": []},
        "1": {"color": "term:RGL", "mode": "mark", "overrides": []},
        "2": {"color": "term:GL", "mode": "mark", "overrides": []}
      }
    }
  }
}
