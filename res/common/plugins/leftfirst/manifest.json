{
  "schemaVersion": 2,
  "id": "core.ext.leftfirst",
  "name": "Left-first Wordle",
  "version": "1.0.0",
  "author": "Mirekintoc",
  "license": "MIT",
  "description": "A non-standard Wordle grader that resolves matches from left to right.",
  "runtime": [
    {
      "id": "lua",
      "backend": "lua",
      "entry": "leftfirst.lua",
      "exports": ["check"]
    }
  ],
  "graders": {
    "core.ext.leftfirst.grader": {
      "name": "Left-first Wordle",
      "runtime": "lua",
      "exports": {"check": "check"},
      "deterministic": true,
      "states": {
        "0": {"color": "term:RGBL", "mode": "spoiler", "overrides": [-1]},
        "1": {"color": "term:RGL", "mode": "mark", "overrides": [-1, 0]},
        "2": {"color": "term:GL", "mode": "mark", "overrides": [-1, 0, 1]}
      }
    }
  }
}
